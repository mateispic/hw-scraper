# Copiază fișierul ăsta ca ".env" lângă check_hotwheels.py și completează valorile.
# .env NU se pune pe GitHub (e în .gitignore).

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
NOTIFY_EMAIL=

# ce scrapere rulează (pe GitHub Actions sunt dezactivate implicit)
SCRAPERS=smyk_html,noriel

# true = testează fără Supabase și fără email
DRY_RUN=false

# secunde de pauză între paginile aceluiași site
PAGE_DELAY=15
